# ===========================================================================
# Multilingual file for the TOS 7 Docker application "threadfindocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Threadfin"
auth         = "Threadfin"
version      = "@@VERSION@@"
descript     = "Threadfin is an IPTV proxy: it merges the M3U playlists and XMLTV guide data you configure and exposes them to Plex, Emby, Jellyfin or an HDHomeRun client as a single tuner on your LAN. This package runs the official Docker Hub image as a non-root container and keeps its configuration in the application data folder on the NAS."
release_note = "1.2.37-4: added the privacy policy (linked from Help) and a licence notice; corrected the Chinese descriptions, which described another application; fixed the web UI address in the text; added the webui.bz2 front-end bundle required by the review (F22/F07); documented the IPTV/EPG, logo, GitHub and Docker Hub endpoints. Rectified per review comments."
important    = "Open http://<NAS-IP>:8066/web/: the first visit creates the administrator, then add your IPTV and XMLTV sources. Data (settings, mappings, logo cache) lives in /Volume1/DockerAppData/threadfindocker/ and survives restarts. Runs as uid 1000. Needs DockerEngine; add a mirror if Docker Hub is unreachable. LAN players (Plex/Emby/Jellyfin/HDHomeRun) connect to it; it fetches your IPTV/EPG URLs, loads Bootstrap/Font Awesome from Cloudflare CDNs and checks GitHub for updates. Privacy: see Help. Plain HTTP LAN."

[zh-cn]
name         = "Threadfin"
auth         = "Threadfin"
version      = "@@VERSION@@"
descript     = "Threadfin 是一个 IPTV 代理：把您配置的 M3U 播放列表和 XMLTV 节目单合并，汇聚成局域网内的一个调谐器，供 Plex、Emby、Jellyfin 或 HDHomeRun 客户端使用。本应用以非 root 容器运行 Docker Hub 官方镜像，配置保存在 NAS 的应用数据目录。"
release_note = "1.2.37-4：新增隐私政策（帮助链接）与许可证声明；修正中文描述（原描述写的是另一个应用）；修正文案里的网页地址；按审核要求补充 webui.bz2 前端包（F22/F07）；披露 IPTV/节目单、台标、GitHub 与 Docker Hub 等第三方端点。按审核意见整改。"
important    = "打开 http://<NAS-IP>:8066/web/，首次访问创建管理员，然后在网页里添加 IPTV 提供方和 XMLTV 节目单源。数据（设置、频道映射、台标缓存）保存在 /Volume1/DockerAppData/threadfindocker/，重启和升级不会丢失。容器以 uid 1000 运行。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。局域网内的 Plex/Emby/Jellyfin/HDHomeRun 客户端会连接本应用；本应用会访问您配置的 IPTV/节目单地址、从 Cloudflare CDN 加载 Bootstrap/Font Awesome，并检查 GitHub 更新。隐私政策见帮助链接。局域网内为 HTTP。"

[zh-hk]
name         = "Threadfin"
auth         = "Threadfin"
version      = "@@VERSION@@"
descript     = "Threadfin 是一個 IPTV 代理：把您設定的 M3U 播放清單和 XMLTV 節目表合併，匯聚成區域網路內的一個調諧器，供 Plex、Emby、Jellyfin 或 HDHomeRun 用戶端使用。本應用以非 root 容器執行 Docker Hub 官方映像，設定保存在 NAS 的應用資料目錄。"
release_note = "1.2.37-4：新增隱私政策（說明連結）與授權聲明；修正中文描述（原描述寫的是另一個應用）；修正文案裡的網頁位址；依審核要求補上 webui.bz2 前端包（F22/F07）；揭露 IPTV/節目表、台標、GitHub 與 Docker Hub 等第三方端點。依審核意見整改。"
important    = "開啟 http://<NAS-IP>:8066/web/，首次存取建立管理員，然後在網頁裡加入 IPTV 提供者與 XMLTV 節目表來源。資料（設定、頻道對應、台標快取）保存在 /Volume1/DockerAppData/threadfindocker/，重新啟動和升級不會遺失。容器以 uid 1000 執行。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。區域網路內的 Plex/Emby/Jellyfin/HDHomeRun 用戶端會連線本應用；本應用會存取您設定的 IPTV/節目表位址、從 Cloudflare CDN 載入 Bootstrap/Font Awesome，並檢查 GitHub 更新。隱私政策見說明連結。區域網路內為 HTTP。"

